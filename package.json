    "clsx": "2.1.1",
    "lucide-react": "1.62.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sip.js": "0.21.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
