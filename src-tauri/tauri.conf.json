{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimHub Phone",
  "version": "0.1.0",
  "identifier": "local.simhub.phone",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5188",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SimHub Phone",
        "width": 640,
        "height": 580,
        "minWidth": 340,
        "minHeight": 500,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:* ws: wss:; media-src 'self' blob: mediastream:; img-src 'self' data:; object-src 'none'; base-uri 'self'",
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-close",
            "core:window:allow-destroy",
            "core:window:allow-hide",
            "core:window:allow-is-focused",
            "core:window:allow-minimize",
            "core:window:allow-request-user-attention",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-focus",
            "core:window:allow-show",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-start-dragging",
            "core:window:allow-unminimize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "SimHub SIP Softphone",
    "longDescription": "SimHub SIP Softphone Desktop Client"
  }
}
